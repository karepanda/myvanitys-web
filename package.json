    "react-router-dom": "^7.18.4",
    "uuid": "^11.1.1",
    "web-vitals": "^2.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:e2e:visual": "playwright test",
