# The API proxy (upstream + /api/v1/ location) has been intentionally removed.
# The frontend calls the backend directly via VITE_API_URL (absolute URL baked in at build time),
# so nginx does not need to proxy API traffic — the browser reaches the API directly.
events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/json application/xml
               image/svg+xml;

    # Consistent security headers (including the staged CSP). Emitted at the
    # http level so every response inherits them by default.
    include /etc/nginx/security-headers.conf;

    server {
        listen ${PORT};
        server_name localhost;

        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            # A location-level `add_header` disables inheritance from http/server,
            # so re-apply the security headers here as well.
            include /etc/nginx/security-headers.conf;
        }

        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;
    }
}
