# The API proxy (upstream + /api/v1/ location) has been intentionally removed.
# The frontend calls the backend directly via VITE_API_URL (absolute URL baked in at build time),
# so nginx does not need to proxy API traffic — the browser reaches the API directly.
events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/json application/xml
               image/svg+xml;

    # Do not record the OAuth callback query string (which carries the
    # one-time authorization code and state) in the access log. Same-origin
    # asset requests use the full callback URL as their referer, so redact
    # the query string from the Referer header too.
    map $request_uri $loggable_request_uri {
        ~^/callback(\?.*)?$  /callback;
        default              $request_uri;
    }

    map $http_referer $loggable_referer {
        ~^(.*/callback)\?.*$  $1;
        default               $http_referer;
    }

    log_format redacted '$remote_addr - $remote_user [$time_local] '
                        '"$request_method $loggable_request_uri $server_protocol" '
                        '$status $body_bytes_sent "$loggable_referer" "$http_user_agent"';

    server {
        listen ${PORT};
        server_name localhost;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        access_log /var/log/nginx/access.log redacted;
        error_log /var/log/nginx/error.log;
    }
}
